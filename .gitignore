# Vendored game clones. Each has its own .git inside, so committing one would
# create a broken gitlink rather than real files. None is linked from
# games/games.html. Delete the folder or add it as a real submodule if you ever
# want it on the site.
games/CarDash/
games/gorescript/
games/SuperTux-Classic/
games/animal-crossing-major-project/
games/Thomas-was-a-clone/
games/vibe-jet/
games/soccer_game/
games/javascript-starfield/

# Clones at the repo root. The leading slash anchors these to the root, so
# Sky-Combat/ does NOT also swallow games/Sky-Combat, which is a real tracked
# game linked from games.html.
/Sky-Combat/
/slop-newyork/

